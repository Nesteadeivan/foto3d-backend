# --- Todo esto es OPCIONAL: el backend funciona sin ningun .env ---

# Orden de motores 3D que se intentan, separados por comas.
# Opciones: trellis-community | trellis2 | hunyuan3d
FOTO3D_PROVIDERS=trellis-community,trellis2,hunyuan3d

# Token gratuito de Hugging Face (https://huggingface.co/settings/tokens).
# Sin el, la app nombra los objetos "Objeto 1, 2, 3...".
# Con el, una IA de vision los reconoce y les pone nombre automaticamente.
HF_TOKEN=

# Puerto del servidor
FOTO3D_PORT=8000
